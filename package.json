{
	"name": "ripple-clerk",
	"version": "0.1.0",
	"description": "Unofficial Clerk integration for Ripple.",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"exports": {
		".": "./src/lib/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"src/lib",
		"src/types"
	],
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"build": "vite build",
		"serve": "vite preview",
		"lint": "eslint .",
